# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: Never add SUPABASE_SERVICE_ROLE_KEY here!
# The service role key must only be used in Supabase Edge Functions (server-side).
# Edge Functions access it via Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')
# which is automatically injected by Supabase - you never need to set it manually.
